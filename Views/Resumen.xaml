<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ocutiExamen.Views.Resumen"
             Title="Resumen">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label x:Name="lblUsuarioConectado" />
        <Label Text="RESUMEN" HorizontalOptions="Center" />

        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*, *">
            <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" />
            <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" />

            <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" />
            <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" />

            <Label Grid.Row="2" Grid.Column="0" Text="Edad:" />
            <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" />

            <Label Grid.Row="3" Grid.Column="0" Text="Fecha inicio:" />
            <Label x:Name="lblFecha" Grid.Row="3" Grid.Column="1" />

            <Label Grid.Row="4" Grid.Column="0" Text="Plan:" />
            <Label x:Name="lblPlan" Grid.Row="4" Grid.Column="1" />

            <Label Grid.Row="5" Grid.Column="0" Text="Casillero:" />
            <Label x:Name="lblCasillero" Grid.Row="5" Grid.Column="1" />

            <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial:" />
            <Label x:Name="lblMonto" Grid.Row="6" Grid.Column="1" />

            <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual:" />
            <Label x:Name="lblPagoMensual" Grid.Row="7" Grid.Column="1" />

            <Label Grid.Row="8" Grid.Column="0" Text="Pago Total:" />
            <Label x:Name="lblPagoTotal" Grid.Row="8" Grid.Column="1" />
        </Grid>

        <Button Text="Nuevo registro" Clicked="btnNuevo_Clicked" />
        <Button Text="Cerrar sesión" Clicked="btnCerrar_Clicked" />
    </VerticalStackLayout>
</ContentPage>